          <mxGeometry height="18" width="220" x="505" y="-567" as="geometry" />
        </mxCell>
        <mxCell id="JH4XCYX-6G3ysAOQKKFJ-247" parent="1" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=13;" value="GET  /v1/rooms/{roomId}/history" vertex="1">
          <mxGeometry height="18" width="220" x="505" y="-549" as="geometry" />
        </mxCell>
        <mxCell id="JH4XCYX-6G3ysAOQKKFJ-249" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;OT / CRDT Deep Dive&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;Problem:&lt;/b&gt; User A types &#39;X&#39; at pos 5, User B deletes char at pos 3 — simultaneously.&lt;br&gt;Without conflict resolution → state diverges on A and B.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;OT (Operational Transformation):&lt;/b&gt;&lt;br&gt;Op = { type: insert|delete, pos: int, char: string, version: int }&lt;br&gt;Server receives Op_A (v=5) and Op_B (v=5). Applies Op_A first → transforms Op_B position by +1 → applies Op_B(transformed).&lt;br&gt;All clients converge to same state. Key: total order via server version counter.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;CRDT (Conflict-free Replicated Data Type):&lt;/b&gt;&lt;br&gt;Each char gets unique ID = (userId, localClock). Ops are commutative + idempotent.&lt;br&gt;No central ordering needed. Merge is always consistent. Best for P2P setups.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;This system uses OT&lt;/b&gt; (server-authoritative) for simplicity with central server.&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="360" width="1100" x="104.99000000000001" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="JH4XCYX-6G3ysAOQKKFJ-250" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Scaling &amp;amp; Design Decisions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;&quot;&gt;1. &lt;b style=&quot;&quot;&gt;Sticky sessions&lt;/b&gt;: All WS connections for a room route to same WS GW node (consistent hashing on roomId) — avoids cross-node op reordering.&lt;br&gt;2. &lt;b style=&quot;&quot;&gt;Redis Pub/Sub&lt;/b&gt;: When scaling to N WS GW nodes, broadcast via Redis channel so all nodes push to their connected clients.&lt;br&gt;3. &lt;b style=&quot;&quot;&gt;Op versioning&lt;/b&gt;: Server assigns monotonic version to each op. Clients buffer out-of-order ops and re-apply after gap is filled.&lt;br&gt;4. &lt;b style=&quot;&quot;&gt;Snapshot compaction&lt;/b&gt;: Every 500 ops, Snapshot Worker collapses op-log into a full document snapshot → reduces MongoDB op-log reads on room rejoin.&lt;br&gt;5. &lt;b style=&quot;&quot;&gt;Code Execution sandbox&lt;/b&gt;: Docker container per job, max 5s CPU, 256MB RAM, no network. Results via Kafka → Redis → WS push.&lt;br&gt;6. &lt;b style=&quot;&quot;&gt;Presence TTL&lt;/b&gt;: Cursor keys in Redis have 30s TTL, refreshed on activity. Auto-removed on disconnect.&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="280" width="1325.01" x="-7.509999999999998" y="1960" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
